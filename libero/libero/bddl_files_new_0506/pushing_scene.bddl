    (stove_region
      (:target main_table)
      (:ranges
        (
          (-0.42 -0.15 -0.4 -0.13)))))
  (:fixtures main_table - table)
  (:objects akita_black_bowl_1 akita_black_bowl_2 - akita_black_bowl glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin black_book_1 - black_book white_yellow_mug_1 - white_yellow_mug)
  (:obj_of_interest akita_black_bowl_1 black_book_1 white_yellow_mug_1)
  (:init
    (On akita_black_bowl_1 main_table_between_plate_ramekin_region)
    (On akita_black_bowl_2 main_table_next_to_ramekin_region)
    (On black_book_1 main_table_black_book_region)
    (On white_yellow_mug_1 main_table_white_yellow_mug_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_ramekin_region))
  (:goal
    (And
      (On akita_black_bowl_1 main_table_plate_region))))
